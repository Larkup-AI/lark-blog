# ─────────────────────────────────────────────────────────────────────────────
# Lark Blog Studio — environment variables
# Copy to .env (or .env.local) and fill in. Only DATABASE_URL, BETTER_AUTH_SECRET
# and ENCRYPTION_KEY are required to boot. Everything else is optional/pluggable.
#
# First run? Start the app and open /setup — the wizard runs migrations, creates
# your admin + workspace, and configures storage/email/AI from the UI (stored
# encrypted in the DB, overriding the env vars below). Setting them here still
# works and acts as the fallback / default.
# ─────────────────────────────────────────────────────────────────────────────

# ── Core (required) ──────────────────────────────────────────────────────────
# Any Postgres connection string (Neon, Supabase, RDS, Railway, local Docker).
DATABASE_URL=postgresql://user:pass@localhost:5432/lark

# Secret for signing sessions. Generate: openssl rand -base64 32
BETTER_AUTH_SECRET=

# Secret for encrypting provider keys at rest (AES-256-GCM). Generate the same way.
# If unset, falls back to BETTER_AUTH_SECRET (set a dedicated key in production).
ENCRYPTION_KEY=

# Public base URL of this deployment (auth callbacks, invite links).
# On Vercel this is auto-detected; set explicitly for custom domains.
APP_URL=http://localhost:3000

# First owner on a fresh install. Optional once the owner account exists.
ADMIN_EMAIL=

# ── Branding (optional) ──────────────────────────────────────────────────────
NEXT_PUBLIC_APP_NAME=Lark Blog Studio
NEXT_PUBLIC_APP_SHORT_NAME=Lark
NEXT_PUBLIC_APP_LOGO=/logo.png
# NEXT_PUBLIC_APP_DESCRIPTION=
# NEXT_PUBLIC_DOCS_URL=https://docs.lark.blog

# ── Deployment mode ──────────────────────────────────────────────────────────
# selfhost (default) or cloud. Cloud unlocks multi-tenant + EE features.
DEPLOYMENT_MODE=selfhost
# DISABLE_SIGNUP=true          # lock sign-up after the first owner (single-tenant)
# LICENSE_KEY=                 # unlocks /ee features on self-host

# ── AI providers ─────────────────────────────────────────────────────────────
# The active provider is chosen per-workspace in Settings → AI. These are only
# fallbacks / gateway creds. Supported: gateway, openrouter, openai, anthropic,
# google, xai, deepseek, mistral, groq, ollama, lmstudio, custom.
AI_GATEWAY_API_KEY=
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=

# ── Object storage ───────────────────────────────────────────────────────────
# STORAGE_PROVIDER = uploadthing (default) | s3 | vercel-blob | local
STORAGE_PROVIDER=uploadthing

# UploadThing (default)
UPLOADTHING_TOKEN=

# S3-compatible (AWS S3, Cloudflare R2, MinIO, Backblaze B2, DO Spaces,
# Supabase Storage, Tigris, Neon Object Storage). Requires:
#   pnpm add @aws-sdk/client-s3 @aws-sdk/s3-request-presigner
# S3_BUCKET=
# S3_REGION=auto
# S3_ENDPOINT=https://<account>.r2.cloudflarestorage.com
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# S3_PUBLIC_BASE_URL=https://cdn.example.com
# S3_FORCE_PATH_STYLE=true     # MinIO and most S3-compatible stores

# ── Email ────────────────────────────────────────────────────────────────────
# EMAIL_PROVIDER = resend | smtp | none   (inferred if unset)
# With "none", invites become copyable links and reset links are logged.
# EMAIL_PROVIDER=resend
# EMAIL_FROM=Lark <noreply@example.com>
RESEND_API_KEY=
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASS=
# SMTP_SECURE=false

# ── Scheduling (cron auto-generation) ────────────────────────────────────────
# CRON_SECRET=                 # protects /api/cron/tick

# ── Misc ─────────────────────────────────────────────────────────────────────
# TRUSTED_ORIGINS=https://app.example.com,https://blog.example.com
